<?xml version="1.0"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable>stake</variable>
    <variable>loss_count</variable>
    <variable>direction</variable>
    <variable>previous_tick</variable>
    <variable>trend_score</variable>
    <variable>total_profit</variable>
  </variables>
  <block type="trade_definition_tradeoptions" id="trade" x="20" y="20">
    <field name="TRADETYPE">DIGITEVEN</field>
    <field name="DURATIONTYPE">ticks</field>
    <field name="DURATION">1</field>
    <field name="BARRIER"></field>
    <field name="BASIS">stake</field>
    <value name="AMOUNT">
      <block type="math_number">
        <field name="NUM">1</field>
      </block>
    </value>
    <value name="CURRENCY">
      <block type="text">
        <field name="TEXT">USD</field>
      </block>
    </value>
  </block>

  <block type="variables_set" x="20" y="140">
    <field name="VAR">stake</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">1</field>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR">loss_count</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">0</field>
          </block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR">trend_score</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>

  <block type="tick_analysis" x="20" y="280">
    <field name="SYMBOL">R_100</field>
    <next>
      <block type="controls_if">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">GT</field>
            <value name="A">
              <block type="variables_get">
                <field name="VAR">tick</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get">
                <field name="VAR">previous_tick</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set">
            <field name="VAR">trend_score</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR">trend_score</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <else>
          <block type="variables_set">
            <field name="VAR">trend_score</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">SUBTRACT</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR">trend_score</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </else>
        <next>
          <block type="variables_set">
            <field name="VAR">previous_tick</field>
            <value name="VALUE">
              <block type="variables_get">
                <field name="VAR">tick</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>

  <block type="trade_purchase" x="20" y="500">
    <value name="CONDITION">
      <block type="logic_ternary">
        <value name="IF">
          <block type="logic_compare">
            <field name="OP">GT</field>
            <value name="A">
              <block type="variables_get">
                <field name="VAR">trend_score</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <value name="THEN">
          <block type="text">
            <field name="TEXT">DIGITEVEN</field>
          </block>
        </value>
        <value name="ELSE">
          <block type="text">
            <field name="TEXT">DIGITODD</field>
          </block>
        </value>
      </block>
    </value>
  </block>
</xml>
